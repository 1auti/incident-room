{
  "mcpServers": {
    "postgres": {
      "command": "uvx",
      "args": ["--overrides", ".mcp-overrides.txt", "--with", "mcp<2", "postgres-mcp==0.3.0", "--access-mode=restricted"],
      "env": { "DATABASE_URI": "${AGENT_RO_DATABASE_URL}" }
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
