{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "postgres": {
      "type": "local",
      "command": ["uvx", "--with", "mcp<2", "postgres-mcp", "--access-mode=restricted"],
      "environment": { "DATABASE_URI": "{env:AGENT_RO_DATABASE_URL}" }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
